# 1) Paste your bot token here (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=paste-your-bot-token-here

# Your game server: europe, america, asia or tw (event end times are adjusted to it)
GAME_SERVER=europe

# Your timezone (used for the daily reminder time and for dates you type in /event add)
TIMEZONE=Africa/Casablanca

# Daily check-in reminder time (24h clock), or "off"
DAILY_REMINDER_TIME=20:00

# When to remind before something ends, in hours (72 = 3 days)
REMINDER_HOURS=72,24,3

# Also remind about banners ending (true/false)
REMIND_BANNERS=true

# Optional: who to ping for 24h/3h reminders and new codes, e.g. @everyone (leave empty for no ping)
MENTION=

# Linked HoYoLAB accounts: ping this many minutes before Resin / Trailblaze Power / Battery is full
STAMINA_ALERT_MINUTES=60
